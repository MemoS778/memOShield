# Optional volume signal, NOT a definitive Nmap or distinct-port detector.
# HOME_NET must describe hosts visible to and protected by your sensor.
alert tcp any any -> $HOME_NET any (msg:"memOShield: high TCP SYN volume (20/60s), investigate"; flags:S; flow:stateless; detection_filter:track by_src, count 20, seconds 60; classtype:attempted-recon; sid:1000001; rev:1;)
